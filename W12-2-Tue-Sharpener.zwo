<workout_file>
  <author>Return-to-Peak plan</author>
  <name>RTP W12 Tue - Sharpener</name>
  <description>Week 12, Tue. 3 x 3 min at 110%, then 10 min at 95%. 75 min. Power is % of your Zwift FTP — update FTP after each test.</description>
  <sportType>bike</sportType>
  <tags><tag name="RTP"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.55"/>
    <Warmup Duration="420" PowerLow="0.55" PowerHigh="0.72"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="3" OnDuration="180" OffDuration="180" OnPower="1.10" OffPower="0.55"/>
    <SteadyState Duration="300" Power="0.55"/>
    <SteadyState Duration="600" Power="0.95"/>
    <SteadyState Duration="1020" Power="0.66"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
