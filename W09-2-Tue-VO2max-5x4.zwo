    <Warmup Duration="420" PowerLow="0.55" PowerHigh="0.72"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="2" OnDuration="60" OffDuration="120" OnPower="1.10" OffPower="0.55"/>
    <IntervalsT Repeat="5" OnDuration="240" OffDuration="240" OnPower="1.12" OffPower="0.55"/>
    <SteadyState Duration="1140" Power="0.66"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
