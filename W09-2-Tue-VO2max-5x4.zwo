<workout_file>
  <author>Return-to-Peak plan</author>
  <name>RTP W09 Tue - VO2max 5x4</name>
  <description>Week 9, Tue. 5 x 4 min at 112%, 4 min easy. 90 min. Power is % of your Zwift FTP — update FTP after each test.</description>
