<workout_file>
  <author>Return-to-Peak plan</author>
  <name>RTP W10 Tue - 30-15s 3 sets</name>
  <description>Week 10, Tue. 3 sets of 13 x (30 s at 127% / 15 s at 50%), 5 min between. 90 min. Power is % of your Zwift FTP — update FTP after each test.</description>
  <sportType>bike</sportType>
  <tags><tag name="RTP"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.55"/>
    <Warmup Duration="420" PowerLow="0.55" PowerHigh="0.72"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.27" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.55"/>
    <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.27" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.55"/>
    <IntervalsT Repeat="13" OnDuration="30" OffDuration="15" OnPower="1.27" OffPower="0.50"/>
    <SteadyState Duration="1545" Power="0.66"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
