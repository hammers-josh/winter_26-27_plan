<workout_file>
  <author>Return-to-Peak plan</author>
  <name>RTP W05 Thu - Over-unders 3x12</name>
  <description>Week 5, Thu. 3 x 12 min of (2 min 95% / 1 min 105%), 6 min easy. 90 min. Power is % of your Zwift FTP — update FTP after each test.</description>
  <sportType>bike</sportType>
  <tags><tag name="RTP"/></tags>
  <workout>
    <Warmup Duration="300" PowerLow="0.45" PowerHigh="0.55"/>
    <Warmup Duration="420" PowerLow="0.55" PowerHigh="0.72"/>
    <SteadyState Duration="180" Power="0.55"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.05"/>
    <SteadyState Duration="360" Power="0.55"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.05"/>
    <SteadyState Duration="360" Power="0.55"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="60" OnPower="0.95" OffPower="1.05"/>
    <SteadyState Duration="1020" Power="0.66"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45"/>
  </workout>
</workout_file>
